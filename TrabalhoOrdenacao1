
import java.util.Arrays;
import java.util.Random;

public class TrabalhoOrdenacao1 {

    public static void selecaoDireta(int[] vetor) {
        for (int i = 0; i < vetor.length - 1; i++) {
            int menor = i;
            for (int j = i + 1; j < vetor.length; j++) {
                if (vetor[j] < vetor[menor]) {
                    menor = j;
                }
            }
            int aux = vetor[i];
            vetor[i] = vetor[menor];
            vetor[menor] = aux;
        }
    }

    public static void bubbleSort(int[] vetor) {
        for (int i = 0; i < vetor.length - 1; i++) {
            for (int j = 0; j < vetor.length - 1 - i; j++) {
                if (vetor[j] > vetor[j + 1]) {
                    int aux = vetor[j];
                    vetor[j] = vetor[j + 1];
                    vetor[j + 1] = aux;
                }
            }
        }
    }

    public static void insercaoDireta(int[] vetor) {
        for (int i = 1; i < vetor.length; i++) {
            int atual = vetor[i];
            int j;
            for (j = i - 1; j >= 0 && vetor[j] > atual; j--) {
                vetor[j + 1] = vetor[j];
            }
            vetor[j + 1] = atual;
        }
    }

    public static void main(String[] args) {

        // ===================== VETOR ALEATÓRIO =====================
        Random gerador = new Random();
        int[] aleatorio = new int[1000];
        for (int i = 0; i < aleatorio.length; i++) {
            aleatorio[i] = gerador.nextInt(10000);
        }

        int[] vet1 = Arrays.copyOf(aleatorio, aleatorio.length);
        int[] vet2 = Arrays.copyOf(aleatorio, aleatorio.length);
        int[] vet3 = Arrays.copyOf(aleatorio, aleatorio.length);

        System.out.println("===== VETOR ALEATÓRIO =====");

        long inicioBubble = System.nanoTime();
        bubbleSort(vet1);
        long fimBubble = System.nanoTime();
        System.out.println("Tempo do Bubble Sort: " + (fimBubble - inicioBubble) / 1_000_000 + " ms");

        long inicioInsercao = System.nanoTime();
        insercaoDireta(vet2);
        long fimInsercao = System.nanoTime();
        System.out.println("Tempo do Inserção Direta: " + (fimInsercao - inicioInsercao) / 1_000_000 + " ms");

        long inicioSelecao = System.nanoTime();
        selecaoDireta(vet3);
        long fimSelecao = System.nanoTime();
        System.out.println("Tempo do Seleção Direta: " + (fimSelecao - inicioSelecao) / 1_000_000 + " ms");

        // ===================== VETOR ORDENADO =====================
        int[] ordenado = new int[1000];
        for (int i = 0; i < ordenado.length; i++) {
            ordenado[i] = i;
        }

        int[] vet4 = Arrays.copyOf(ordenado, ordenado.length);
        int[] vet5 = Arrays.copyOf(ordenado, ordenado.length);
        int[] vet6 = Arrays.copyOf(ordenado, ordenado.length);

        System.out.println("\n===== VETOR ORDENADO =====");

        long inicioBubble2 = System.nanoTime();
        bubbleSort(vet4);
        long fimBubble2 = System.nanoTime();
        System.out.println("Tempo do Bubble Sort: " + (fimBubble2 - inicioBubble2) / 1_000_000 + " ms");

        long inicioInsercao2 = System.nanoTime();
        insercaoDireta(vet5);
        long fimInsercao2 = System.nanoTime();
        System.out.println("Tempo do Inserção Direta: " + (fimInsercao2 - inicioInsercao2) / 1_000_000 + " ms");

        long inicioSelecao2 = System.nanoTime();
        selecaoDireta(vet6);
        long fimSelecao2 = System.nanoTime();
        System.out.println("Tempo do Seleção Direta: " + (fimSelecao2 - inicioSelecao2) / 1_000_000 + " ms");

        // ===================== VETOR INVERTIDO =====================
        int[] invertido = new int[1000];
        for (int i = 0; i < invertido.length; i++) {
            invertido[i] = invertido.length - i;
        }

        int[] vet7 = Arrays.copyOf(invertido, invertido.length);
        int[] vet8 = Arrays.copyOf(invertido, invertido.length);
        int[] vet9 = Arrays.copyOf(invertido, invertido.length);

        System.out.println("\n===== VETOR INVERTIDO =====");

        long inicioBubble3 = System.nanoTime();
        bubbleSort(vet7);
        long fimBubble3 = System.nanoTime();
        System.out.println("Tempo do Bubble Sort: " + (fimBubble3 - inicioBubble3) / 1_000_000 + " ms");

        long inicioInsercao3 = System.nanoTime();
        insercaoDireta(vet8);
        long fimInsercao3 = System.nanoTime();
        System.out.println("Tempo do Inserção Direta: " + (fimInsercao3 - inicioInsercao3) / 1_000_000 + " ms");

        long inicioSelecao3 = System.nanoTime();
        selecaoDireta(vet9);
        long fimSelecao3 = System.nanoTime();
        System.out.println("Tempo do Seleçao Direta: " + (fimSelecao3 - inicioSelecao3) / 1_000_000 + " ms");
    }
}

