import java.util.Arrays;

public class BubbleSort {
    public static void main(String[] args) {
        int[] numeros = {25, 57, 48, 37, 12, 86, 33};

        for (int i = 0; i < numeros.length - 1; i++) { // -1 porque não precisa verificar o último número
            for (int j = 0; j < numeros.length - 1 - i; j++) { // -i porque o final já está ordenado a cada passada
                if (numeros[j] > numeros[j + 1]) {
                    int aux = numeros[j];
                    numeros[j] = numeros[j + 1];
                    numeros[j + 1] = aux;
                }
            }
        }

        System.out.println("|VETOR EM ORDEM CRESCENTE|");
        System.out.println(Arrays.toString(numeros));
    }
}
