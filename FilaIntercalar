import java.util.ArrayDeque;
import java.util.Queue;

public class Exercicio1Intercalar {

    // Função que intercala duas filas
    public static Queue<Integer> intercalar(Queue<Integer> fila1, Queue<Integer> fila2) {
        Queue<Integer> resultado = new ArrayDeque<>();

        while (!fila1.isEmpty() || !fila2.isEmpty()) { // Continua enquanto pelo menos uma das filas tiver elementos
            if (!fila1.isEmpty()) {
                resultado.add(fila1.poll());
            }
            if (!fila2.isEmpty()) {
                resultado.add(fila2.poll());
            }
        }

        return resultado;
    }

    public static void main(String[] args) {
        Queue<Integer> fila1 = new ArrayDeque<>();
        Queue<Integer> fila2 = new ArrayDeque<>();

        // Insere elementos na fila 1
        fila1.add(1);
        fila1.add(3);
        fila1.add(5);

        // Insere elementos na fila 2
        fila2.add(2);
        fila2.add(4);
        fila2.add(6);
        fila2.add(8);

        System.out.println("Fila 1: " + fila1);
        System.out.println("Fila 2: " + fila2);

        // Intercala as filas
        Queue<Integer> intercalada = intercalar(fila1, fila2);
        System.out.println("Fila intercalada: " + intercalada);
    }
}
