import java.time.LocalDateTime;

public class Matricula {
    private int nro;
    private Aluno aluno;
    private Disciplina disciplina;
    private LocalDateTime data;

    private float nota;
    public Matricula() {
        this(0, null, null, LocalDateTime.now());
    }

    public Matricula(int nro, Aluno aluno, Disciplina disciplina, LocalDateTime data) {
        this.nro = nro;
        this.aluno = aluno;
        this.disciplina = disciplina;
        this.nota = 0;
        this.data = data;
    }
    public static Matricula matricular(int nro, Aluno aluno, Disciplina disciplina){
        Matricula m = new Matricula(nro, aluno, disciplina, LocalDateTime.now());
        aluno.adicionarMatricula(m);
        disciplina.adicionarMatricula(m);
        return m;
    }


    public int getNro() {
        return nro;
    }

    public void setNro(int nro) {
        this.nro = nro;
    }

    public Aluno getAluno() {
        return aluno;
    }

    public void setAluno(Aluno aluno) {
        this.aluno = aluno;
    }

    public Disciplina getDisciplina() {
        return disciplina;
    }

    public void setDisciplina(Disciplina disciplina) {
        this.disciplina = disciplina;
    }

    public float getNota() {
        return nota;
    }

    public void setNota(float nota) {
        this.nota = nota;
    }

    public LocalDateTime getData() {
        return data;
    }

    public void setData(LocalDateTime data) {
        this.data = data;
    }

    @Override
    public String toString() {
        return "Matricula{" +
                "nro=" + nro +
                ", aluno=" + aluno +
                ", disciplina=" + disciplina +
                ", nota=" + nota +
                ", data=" + data +
                '}';
    }

}
