
import java.util.Random;
import java.util.Arrays;

public class TrabalhoOrdenacaoBimestral {

    public static void main(String[] args) {

         // Tamanhos do vetor
        // Esses valores podem ser alterados aqui conforme necessário (100, 1.000, 10.000, 100.000)

        int[] tamanhos = {100, 1000, 10000, 100000}; // Tamanhos do vetor

        for (int tamanho : tamanhos) {
            System.out.println("\n--- TAMANHO DO VETOR: " + tamanho + " ---");

            // VETOR CRESCENTE ORDENADO
            System.out.println("\n--- Ordem Crescente ---");
            int[] crescente = gerarVetorCrescente(tamanho);
            testarTodos(crescente);

            //  VETOR DECRESCENTE INVERTIDO
            System.out.println("\n--- Ordem Decrescente ---");
            int[] decrescente = gerarVetorDecrescente(tamanho);
            testarTodos(decrescente);

            // VETOR ALEATÓRIO
            System.out.println("\n--- Ordem Aleatória ---");
            int[] aleatorio = gerarVetorAleatorio(tamanho);
            testarTodos(aleatorio);
        }
    }

    // ===== GERADORES DE VETOR =====

    public static int[] gerarVetorCrescente(int tamanho) {
        int[] vetor = new int[tamanho];
        for (int i = 0; i < vetor.length; i++) {
            vetor[i] = i;
        }
        return vetor;
    }

    public static int[] gerarVetorDecrescente(int tamanho) {
        int[] vetor = new int[tamanho];
        for (int i = 0; i < vetor.length; i++) {
            vetor[i] = vetor.length - i;
        }
        return vetor;
    }

    public static int[] gerarVetorAleatorio(int tamanho) {
        Random random = new Random();
        int[] vetor = new int[tamanho];
        for (int i = 0; i < vetor.length; i++) {
            vetor[i] = random.nextInt(1000000);
        }
        return vetor;
    }

    // ===== ALGORITMOS DE ORDENAÇÃO =====

    public static void bubbleSort(int[] numeros) {
        for (int i = 0; i < numeros.length - 1; i++) {
            for (int j = 0; j < numeros.length - 1 - i; j++) {
                if (numeros[j] > numeros[j + 1]) {
                    int aux = numeros[j];
                    numeros[j] = numeros[j + 1];
                    numeros[j + 1] = aux;
                }
            }
        }
    }

    public static void selecaoDireta(int[] numeros) {
        for (int i = 0; i < numeros.length - 1; i++) {
            int menor = i;
            for (int j = i + 1; j < numeros.length; j++) {
                if (numeros[j] < numeros[menor]) {
                    menor = j;
                }
            }
            int aux = numeros[i];
            numeros[i] = numeros[menor];
            numeros[menor] = aux;
        }
    }

    public static void insercaoDireta(int[] numeros) {
        for (int i = 1; i < numeros.length; i++) {
            int aux = numeros[i];
            int j;
            for (j = i - 1; j >= 0 && numeros[j] > aux; j--) {
                numeros[j + 1] = numeros[j];
            }
            numeros[j + 1] = aux;
        }
    }

    public static void quickSort(int[] numeros, int inicio, int fim) {
        if (inicio < fim) {
            int posicaoPivo = particionar(numeros, inicio, fim);
            quickSort(numeros, inicio, posicaoPivo - 1);
            quickSort(numeros, posicaoPivo + 1, fim);
        }
    }

    // usa o elemento do meio como pivô (em vez do último) para evitar
    // o pior caso (recursão profunda / StackOverflow) em vetores já
    // ordenados ou invertidos
    public static int particionar(int[] numeros, int inicio, int fim) {
        int meio = inicio + (fim - inicio) / 2;
        int trocaPivo = numeros[meio];
        numeros[meio] = numeros[fim];
        numeros[fim] = trocaPivo;

        int pivo = numeros[fim];
        int i = inicio - 1;

        for (int j = inicio; j < fim; j++) {
            if (numeros[j] < pivo) {
                i++;
                int aux = numeros[i];
                numeros[i] = numeros[j];
                numeros[j] = aux;
            }
        }

        int aux = numeros[i + 1];
        numeros[i + 1] = numeros[fim];
        numeros[fim] = aux;

        return i + 1;
    }

    // ===== MEDIÇÃO DE TEMPO =====

    public static void testarTodos(int[] vetorOriginal) {
        testarOrdenacao("Bubble Sort", Arrays.copyOf(vetorOriginal, vetorOriginal.length));
        testarOrdenacao("Seleção Direta", Arrays.copyOf(vetorOriginal, vetorOriginal.length));
        testarOrdenacao("Inserção Direta", Arrays.copyOf(vetorOriginal, vetorOriginal.length));
        testarOrdenacao("Quicksort", Arrays.copyOf(vetorOriginal, vetorOriginal.length));
    }

    public static void testarOrdenacao(String nomeAlgoritmo, int[] vetor) {
        long inicio = System.nanoTime();

        switch (nomeAlgoritmo) {
            case "Bubble Sort" -> bubbleSort(vetor);
            case "Seleção Direta" -> selecaoDireta(vetor);
            case "Inserção Direta" -> insercaoDireta(vetor);
            case "Quicksort" -> quickSort(vetor, 0, vetor.length - 1);
        }

        long fim = System.nanoTime();
        double tempoMs = (fim - inicio) / 1000000.0;

        System.out.println(nomeAlgoritmo + ": " + tempoMs + " ms");
    }
}





